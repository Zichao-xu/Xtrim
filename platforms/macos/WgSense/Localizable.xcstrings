    "网卡计数" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عدّاد بطاقة الشبكة"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Interface counters"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شمارش کارت شبکه"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "インターフェースカウンター"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "네트워크 카드 카운터"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Счётчик интерфейса"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ağ kartı sayacı"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bộ đếm card mạng"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "網卡計數"
          }
        }
      }
    },
    "网卡计数与公网测速同一把尺子；iperf3 自报只算它自己的流量。上行有接收端数据时不看这一项" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عدّاد بطاقة الشبكة واستخدام الإنترنت بالمقياس نفسه؛ وما يصرح به iperf3 يُحتسب لحركته هو فقط. ولا يُعتمد هذا البند في الرفع عند توفر بيانات المستقبِل"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Interface counters use the same yardstick as the internet speed test; iperf3 self-reports only its own traffic. Ignored for upload when receiver data is available"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شمارش کارت شبکه و تست سرعت اینترنت یک معیار دارند؛ iperf3 فقط ترافیک خودش را گزارش می‌کند. اگر برای ارسال دادهٔ گیرنده باشد این مورد در نظر گرفته نمی‌شود"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "インターフェースカウンターはインターネット速度測定と同じ基準。iperf3 の報告値は自身の通信のみを数えます。上りは受信側データがあればこの項目は使いません"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "카드 카운터는 공인망 측정과 같은 기준입니다. iperf3 자체 보고는 그 트래픽만 계산합니다. 업로드에 수신 측 데이터가 있으면 이 항목은 사용하지 않습니다"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Счётчик интерфейса и тест интернета — одна мера; iperf3 сообщает только свой трафик. При наличии данных получателя для отдачи этот пункт не учитывается"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ağ kartı sayacı internet hız testiyle aynı ölçüt; iperf3'ün bildirdiği yalnızca kendi trafiğini sayar. Yukarı yönde alıcı verisi varsa bu öğe dikkate alınmaz"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bộ đếm card mạng dùng cùng thước đo với đo tốc độ Internet; iperf3 tự báo chỉ tính lưu lượng của nó. Ở chiều tải lên, nếu có dữ liệu bên nhận thì không xét mục này"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "網卡計數與公網測速同一把尺子；iperf3 自報只算它自己的流量。上行有接收端資料時不看這一項"
          }
        }
      }
    },
