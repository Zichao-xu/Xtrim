          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dựa trên đếm byte; đang chờ gửi phục hồi"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "依位元組計數判斷，正在等待傳送恢復"
          }
        }
      }
    },
    "依赖路由器本机文件（SSH 私钥等），同步时连同经它中转的节点一起去掉" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعتمد على ملفات الراوتر المحلية (مفتاح SSH الخاص وغيره)، ويُستبعد عند المزامنة مع العقد التي يمررها"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Depends on files on the router (SSH private keys, etc.); when syncing, it is removed along with the nodes it relays"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "به فایل‌های محلی روتر (کلید SSH و…) وابسته است؛ هنگام همگام‌سازی همراه با گره‌هایی که از آن عبور می‌کنند حذف می‌شود"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ルーター上のファイル（SSH 秘密鍵など）に依存するため、同期時はこれ経由の中継ノードと一緒に除外されます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "라우터 로컬 파일(SSH 개인 키 등)에 의존하므로 동기화 시 이를 경유하는 노드도 함께 제외됨"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зависит от файлов на роутере (SSH-ключ и т.п.); при синхронизации удаляется вместе с узлами через него"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yönlendiricinin yerel dosyalarına bağlıdır (SSH özel anahtarı vb.); senkronizasyonda üzerinden geçen düğümlerle birlikte çıkarılır"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phụ thuộc tệp cục bộ trên bộ định tuyến (khóa riêng SSH…), khi đồng bộ sẽ bị loại cùng các nút được nó chuyển tiếp"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "依賴路由器本機檔案（SSH 私鑰等），同步時連同經它中轉的節點一併移除"
          }
        }
      }
    },
