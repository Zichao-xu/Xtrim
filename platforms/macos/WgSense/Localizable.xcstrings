    "curl -s -o /dev/null %@--speed-limit %lld --speed-time %lld <下行源>   × %lld，到点为止，断了重连" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "curl -s -o /dev/null %@--speed-limit %lld --speed-time %lld <مصدر التنزيل>   × %lld، حتى الموعد، إعادة الاتصال عند الانقطاع"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "curl -s -o /dev/null %@--speed-limit %lld --speed-time %lld <download-source>   × %lld, until deadline, reconnect on drop"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "curl -s -o /dev/null %@--speed-limit %lld --speed-time %lld <منبع دانلود>   × %lld، تا موعد پایان، اتصال مجدد پس از قطعی"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
