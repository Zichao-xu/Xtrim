    "# 去掉前 %@ 秒（爬坡），剩下的取%@ = 稳定值" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "# تجاهل أول %@ ثانية (التدرّج)، ثم أخذ %@ للباقي = القيمة المستقرة"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "# Discard first %@ seconds (ramp-up); take %@ of the rest = steady value"
