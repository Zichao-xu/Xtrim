          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "# Переходы по одному вручную (реальный DNS на каждом); до %lld переходов, по %lld с"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "# Yönlendirmeleri tek tek elle izle (her adımda gerçek DNS çözümü); en fazla %lld adım, adım başına %lld saniye"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "# Theo chuyển hướng thủ công từng chặng (phân giải DNS thật mỗi chặng), tối đa %lld chặng, mỗi chặng %lld giây"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "# 跳转逐跳手动跟随（每跳用真实 DNS 解析），最多 %1$lld 跳、每跳 %2$lld 秒"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "# 重新導向逐跳手動跟隨（每跳用真實 DNS 解析），最多 %lld 跳、每跳 %lld 秒"
          }
        }
      }
    },
    "# 采样：每 %@ 秒读一次网卡累计字节，相邻两次之差 ÷ 实际间隔 = 速率" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "# أخذ العينات: قراءة إجمالي بايتات الواجهة كل %@ ثانية؛ فرق القراءتين المتتاليتين ÷ الفاصل الفعلي = السرعة"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "# Sampling: read interface byte totals every %@ seconds; consecutive difference ÷ actual interval = rate"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "# نمونه‌برداری: خواندن مجموع بایت‌های رابط هر %@ ثانیه؛ اختلاف دو خوانش پیاپی ÷ فاصلهٔ واقعی = سرعت"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "# サンプリング：%@秒ごとにインターフェースの累積バイト数を取得。前回との差 ÷ 実時間隔 = 速度"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "# 샘플링: %@초마다 네트워크 인터페이스 누적 바이트 조회, 연속 두 값의 차이 ÷ 실제 간격 = 속도"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "# Замеры: суммарные байты интерфейса каждые %@ с; разность соседних замеров ÷ фактический интервал = скорость"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "# Örnekleme: her %@ saniyede arayüzün toplam baytını oku; ardışık fark ÷ gerçek aralık = hız"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "# Lấy mẫu: đọc tổng byte card mạng mỗi %@ giây; chênh lệch hai lần liên tiếp ÷ khoảng thời gian thực = tốc độ"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "# 取樣：每 %@ 秒讀取網卡累計位元組，相鄰兩次之差 ÷ 實際間隔 = 速率"
          }
        }
      }
    },
