    "会停止并删除 Xtrim 系统服务与 helper，可保留用户配置和传输数据。" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(ج) وقف خدمات نظام الاستشعار عن بعد ومساعديه وإزالتها مع الحفاظ على بيانات المستخدمين ونقل البيانات."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stops and removes Xtrim system services and helpers while preserving user profiles and transfer data."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "توقف و حذف خدمات سیستم Xtrim و کمک کنندگان در حالی که حفظ پروفایل کاربر و انتقال داده ها."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xtrim システムサービスと helper を停止して削除し、ユーザーの構成と転送データを保持できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xtrim 시스템 서비스와 helper가 중단되고 삭제되며, 사용자의 구성과 전송 데이터가 보존될 수 있습니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Остановите и удалите Xtrim System Service и helper, чтобы сохранить настройки пользователя и передать данные."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kullanıcı profillerini ve veri aktarımını korurken Xtrim sistem hizmetlerini ve yardımcılarını durdurur ve kaldırır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dừng và gỡ bỏ dịch vụ hệ thống Xtrim và trợ giúp trong khi lưu trữ hồ sơ người dùng và truyền dữ liệu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "会停止并删除 Xtrim 系统服务与 helper，可保留用户配置和传输数据。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "會停止並刪除 Xtrim 系統服務與 helper，可保留用戶配置和傳輸數據。"
          }
        }
      }
    },
    "会再弹一次管理员密码框" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيظهر مربع كلمة مرور المسؤول مرة أخرى"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Will prompt for the administrator password once more"
          }
        },
        "fa" : {
          "stringUnit" : {
