          }
        }
      }
    },
    "# 空载延迟：先空跑 %lld 秒，期间与测速全程一直 ping" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "# زمن الاستجابة دون حمل: خمول أولًا لمدة %lld ثانية، مع ping طوال الخمول واختبار السرعة"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "# Idle latency: idle for %lld seconds first; keep ping running through idle and speed tests"
