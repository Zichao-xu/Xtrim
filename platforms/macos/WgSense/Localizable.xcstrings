    "用 SSH 从「面板」当前路由器拉取 /etc/mihomo 的配置，改写成 Mac 版后替换" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُسحب إعداد /etc/mihomo من راوتر «اللوحة» الحالي عبر SSH، ويُعاد كتابته بصيغة Mac ثم يُستبدل"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use SSH to fetch /etc/mihomo config from the current router on “Panel”, rewrite it for Mac, then replace"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "با SSH پیکربندی /etc/mihomo را از روتر فعلی «پنل» دریافت کن، به نسخه Mac بازنویسی و جایگزین کن"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH で「パネル」の現在のルーターから /etc/mihomo の設定を取得し、Mac 版に書き換えて置き換えます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH로 「패널」 현재 라우터에서 /etc/mihomo 설정을 가져와 Mac 버전으로 고쳐 교체"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Получить по SSH конфигурацию /etc/mihomo с текущего роутера «Панели», переписать под Mac и заменить"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH ile «Panel»deki mevcut yönlendiriciden /etc/mihomo yapılandırması çekilir, Mac sürümüne uyarlanıp değiştirilir"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dùng SSH kéo cấu hình /etc/mihomo từ bộ định tuyến hiện tại của «Bảng điều khiển», viết lại thành bản Mac rồi thay thế"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用 SSH 從「面板」目前路由器拉取 /etc/mihomo 的設定，改寫成 Mac 版後取代"
          }
        }
      }
    },
