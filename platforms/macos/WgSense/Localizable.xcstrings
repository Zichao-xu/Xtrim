        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "# Loại nguồn chậm hơn nguồn nhanh nhất trên %@ lần; giữ %lld nguồn tải xuống và %lld nguồn tải lên nhanh nhất"
