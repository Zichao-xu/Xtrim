    "# %@ 秒滑动平均的最大值 = 峰值" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "# أقصى متوسط متحرك خلال %@ ثانية = الذروة"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "# Maximum %@-second moving average = peak"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "# بیشینهٔ میانگین متحرک %@ ثانیه‌ای = اوج"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "# %@秒移動平均の最大値 = ピーク"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "# %@초 이동 평균의 최댓값 = 최고값"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "# Максимум скользящего среднего за %@ с = пик"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "# %@ saniyelik hareketli ortalamanın en yükseği = tepe"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "# Trung bình trượt %@ giây lớn nhất = đỉnh"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "# %@ 秒移動平均的最大值 = 峰值"
          }
        }
      }
    },
    "# 上行取接收端：实时回传对端日志的 [SUM] 行；对端不是我们起的，测完用 --get-server-output 带回的换掉；都拿不到才用发送端，读数旁标 src" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "# الرفع من جهة المستقبِل: أسطر [SUM] من سجل الطرف الآخر مباشرة؛ إن لم نُشغّله نحن، تُستبدل بعد الاختبار بنتيجة --get-server-output؛ عند تعذر كليهما فقط يُستخدم المرسِل مع علامة src"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "# Upload uses receiver [SUM] lines streamed from peer logs; if we didn't start the peer, replace with --get-server-output after testing; use sender only if neither is available, marked src"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "# آپلود از سمت گیرنده: خطوط [SUM] گزارش همتا به‌صورت زنده؛ اگر همتا را ما اجرا نکرده‌ایم، پس از تست با خروجی --get-server-output جایگزین شود؛ فقط اگر هیچ‌کدام نبود از فرستنده با برچسب src استفاده شود"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "# 上りは受信側：相手ログの [SUM] 行をリアルタイム取得。相手をこちらで起動していない場合は測定後に --get-server-output の結果で置換。両方取得不可なら送信側を使い、値に src を表示"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "# 업로드는 수신 측 사용: 상대 로그의 [SUM] 행을 실시간 수신. 직접 시작한 상대가 아니면 측정 후 --get-server-output 결과로 교체. 둘 다 없을 때만 송신 측을 쓰고 값 옆에 src 표시"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "# Отдача по приёмнику: строки [SUM] из журнала узла в реальном времени; если узел запущен не нами, после теста заменить данными --get-server-output; если оба недоступны, брать отправителя с пометкой src"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "# Yükleme alıcıdan: karşı uç günlüğündeki [SUM] satırları canlı alınır; karşı ucu biz başlatmadıysak test sonrası --get-server-output ile değiştirilir; ikisi de yoksa gönderici kullanılır, değere src eklenir"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "# Tải lên lấy phía nhận: dòng [SUM] từ nhật ký đầu kia gửi về trực tiếp; nếu đầu kia không do ta khởi chạy, đo xong thay bằng kết quả --get-server-output; chỉ dùng phía gửi khi không lấy được cả hai, ghi src cạnh số đo"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "# 上傳取接收端：即時回傳對端日誌的 [SUM] 行；對端非本程式啟動時，測完用 --get-server-output 取回的替換；都拿不到才用傳送端，讀值旁標 src"
          }
        }
      }
    },
    "# 下行速率取 iperf3 每 %@ 秒报的 [SUM] 行" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "# سرعة التنزيل من أسطر [SUM] التي يرسلها iperf3 كل %@ ثانية"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "# Download rate uses iperf3 [SUM] lines reported every %@ seconds"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "# سرعت دانلود از خطوط [SUM] گزارش iperf3 در هر %@ ثانیه"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "# 下り速度は iperf3 が%@秒ごとに出す [SUM] 行を使用"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "# 다운로드 속도는 iperf3가 %@초마다 보고하는 [SUM] 행 사용"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "# Скорость загрузки — по строкам [SUM] iperf3 каждые %@ с"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "# İndirme hızı, iperf3 tarafından her %@ saniyede bildirilen [SUM] satırından alınır"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "# Tốc độ tải xuống lấy dòng [SUM] do iperf3 báo mỗi %@ giây"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "# 下載速率取 iperf3 每 %@ 秒回報的 [SUM] 行"
          }
        }
      }
    },
    "# 下行速率读网卡计数，iperf3 只造流量" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "# سرعة التنزيل من عدّاد واجهة الشبكة؛ iperf3 يولّد حركة البيانات فقط"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "# Download rate uses interface counters; iperf3 only generates traffic"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "# سرعت دانلود از شمارندهٔ رابط شبکه؛ iperf3 فقط ترافیک می‌سازد"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "# 下り速度はネットワークインターフェースのカウンターから取得。iperf3 はトラフィック生成のみ"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "# 다운로드 속도는 네트워크 인터페이스 카운터 사용, iperf3는 트래픽만 생성"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "# Скорость загрузки — по счётчикам интерфейса; iperf3 лишь создаёт трафик"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "# İndirme hızı arayüz sayaçlarından okunur; iperf3 yalnızca trafik üretir"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "# Tốc độ tải xuống đọc bộ đếm card mạng, iperf3 chỉ tạo lưu lượng"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
