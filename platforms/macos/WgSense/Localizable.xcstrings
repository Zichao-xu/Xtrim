    "%@ 解析到 %@，落在兜底网段，疑似代理 fake-ip；代理后端无响应，查不到真实去向" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ يُحلّ إلى %@ ضمن الشبكة الفرعية الاحتياطية، ويُشتبه بأنه fake-ip للوكيل؛ خلفية الوكيل لا تستجيب والوجهة الحقيقية مجهولة"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ resolves to %@ in the fallback subnet, likely proxy fake-ip; proxy backend unresponsive, real destination unknown"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ به %@ در زیرشبکهٔ جایگزین نگاشت شد، احتمالاً fake-ip پروکسی؛ بخش پشتی پروکسی پاسخ نمی‌دهد و مقصد واقعی نامشخص است"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ は %@ に解決され、フォールバックサブネット内のためプロキシ fake-ip の疑い。プロキシバックエンドが無応答で実際の宛先は不明"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@의 조회 결과 %@가 대체 서브넷에 속해 프록시 fake-ip로 의심됨; 프록시 백엔드 응답이 없어 실제 목적지 확인 불가"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ разрешён в %@ из резервной подсети, вероятно fake-ip прокси; бэкенд прокси не отвечает, реальная цель неизвестна"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, yedek alt ağdaki %@ adresine çözümlendi; proxy fake-ip olabilir. Proxy arka ucu yanıt vermiyor, gerçek hedef bulunamıyor"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ phân giải thành %@ trong mạng con dự phòng, nghi là fake-ip của proxy; backend proxy không phản hồi, không tìm được đích thật"
          }
        },
