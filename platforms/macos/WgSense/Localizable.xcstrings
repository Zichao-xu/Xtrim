        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "# 최고 속도보다 %@배 이상 느리면 제외; 다운로드 상위 %lld개, 업로드 상위 %lld개 유지"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
