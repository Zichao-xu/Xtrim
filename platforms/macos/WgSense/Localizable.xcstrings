        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nếu sau gấp đôi tổng thời lượng cộng thêm số giây này vẫn chưa xong thì buộc kết thúc"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "總時長 × 2 再加這麼多秒還沒結束就強制收尾"
          }
        }
      }
    },
