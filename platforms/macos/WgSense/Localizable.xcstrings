    "%@。将按规则自动处理 VPN。" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. ستتم إدارة VPN تلقائيًا وفق القواعد."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. VPN will be managed automatically by rules."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. VPN طبق قوانین خودکار مدیریت می‌شود."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@。ルールに従い VPN を自動管理します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. 규칙에 따라 VPN을 자동 관리합니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. VPN будет управляться автоматически по правилам."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. VPN kurallara göre otomatik yönetilecek."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. VPN sẽ được tự động quản lý theo quy tắc."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@。將依規則自動處理 VPN。"
          }
        }
      }
    },
    "%@。已交给守护按当前网络判断 VPN。" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. أُسند قرار VPN حسب الشبكة الحالية إلى الخدمة الخلفية."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Handed to daemon to manage VPN based on current network."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. مدیریت VPN بر اساس شبکهٔ فعلی به سرویس پس‌زمینه سپرده شد."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@。現在のネットワークに応じた VPN 判断をデーモンに委任しました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. 현재 네트워크에 따른 VPN 판단을 데몬에 맡겼습니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Управление VPN по текущей сети передано фоновой службе."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. VPN kararı mevcut ağa göre arka plan hizmetine bırakıldı."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Đã giao cho dịch vụ nền quyết định VPN theo mạng hiện tại."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@。已交由守護程式依目前網路判斷 VPN。"
          }
        }
      }
    },
    "%@。非信任网络下守护可能自动接管。" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. قد تتولى الخدمة الخلفية التحكم تلقائيًا في شبكة غير موثوقة."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Daemon may take over on untrusted networks."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. در شبکهٔ نامطمئن، سرویس پس‌زمینه ممکن است خودکار کنترل را بگیرد."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@。未信頼ネットワークではデーモンが自動管理する場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. 신뢰하지 않는 네트워크에서는 데몬이 자동으로 제어할 수 있습니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. В недоверенной сети фоновая служба может взять управление."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Güvenilmeyen ağlarda arka plan hizmeti otomatik devralabilir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Dịch vụ nền có thể tự tiếp quản trên mạng không tin cậy."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@。在非信任網路下，守護程式可能自動接管。"
          }
        }
      }
    },
