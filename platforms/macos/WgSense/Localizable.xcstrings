    "WG peer 不能远程登录：要求它自己开着 iperf3 服务端（端口 %lld）" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن الدخول عن بُعد إلى WG peer: يجب تشغيل خادم iperf3 عليه (المنفذ %lld)"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WG peer has no remote login: it must run an iperf3 server (port %lld)"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ورود از راه دور به WG peer ممکن نیست: باید سرور iperf3 روی آن فعال باشد (درگاه %lld)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WG peer はリモートログイン不可：iperf3 サーバーの起動が必要（ポート %lld）"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WG peer 원격 로그인 불가: 해당 기기에서 iperf3 서버 실행 필요 (포트 %lld)"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удалённый вход на WG peer недоступен: на нём нужен сервер iperf3 (порт %lld)"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WG peer uzaktan girişe kapalı: üzerinde iperf3 sunucusu çalışmalı (port %lld)"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể đăng nhập từ xa vào WG peer: cần chạy sẵn máy chủ iperf3 trên đó (cổng %lld)"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WG peer 無法遠端登入：須自行啟動 iperf3 伺服器（連接埠 %lld）"
          }
        }
      }
    },
