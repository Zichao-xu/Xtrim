    "出口 %@ 不可用（%@）：境外直连一律拒绝，国内与局域网照常" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المخرج %1$@ غير متاح (%2$@): تُرفض كل الاتصالات المباشرة الخارجية، وتبقى الداخلية والشبكة المحلية كالمعتاد"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exit %@ unavailable (%@): all direct foreign connections are refused; domestic and LAN unchanged"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خروجی %@ در دسترس نیست (%@): اتصال مستقیم خارجی همیشه رد می‌شود، داخلی و شبکه محلی طبق معمول کار می‌کند"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "出口 %@ が利用不可（%@）：海外への直接接続はすべて拒否、国内と LAN はそのまま"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "출구 %@ 사용 불가(%@): 해외 직접 연결은 모두 거부, 국내와 LAN은 정상"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выход %@ недоступен (%@): все прямые зарубежные соединения отклоняются, отечественные и локальные — как обычно"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çıkış %1$@ kullanılamıyor (%2$@): yurt dışı doğrudan bağlantılar tümüyle reddedilir, yurt içi ve yerel ağ normal çalışır"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đầu ra %1$@ không khả dụng (%2$@): từ chối mọi kết nối trực tiếp ra nước ngoài, trong nước và LAN vẫn như thường"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "出口 %1$@ 不可用（%2$@）：境外直连一律拒绝，国内与局域网照常"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "出口 %@ 不可用（%@）：境外直連一律拒絕，國內與區域網路照常"
          }
        }
      }
    },
    "出口 %@ 在线（%@），纯良不干预，流量全听出口的" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المخرج %@ متصل (%@)، لا يتدخل Purity، وكل حركة البيانات تخضع للمخرج"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exit %@ online (%@); Purity stays out, exit controls all traffic"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خروجی %@ آنلاین است (%@)؛ Purity دخالت نمی‌کند، همهٔ ترافیک تابع خروجی است"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "出口 %@ はオンライン（%@）。純良は介入せず、通信はすべて出口に従います"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "출구 %@ 온라인 (%@), Purity 개입 없이 출구가 모든 트래픽 제어"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выход %@ в сети (%@); Purity не вмешивается, весь трафик под контролем выхода"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çıkış %@ çevrimiçi (%@), Purity müdahale etmez, tüm trafik çıkışa bağlı"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đầu ra %@ trực tuyến (%@), Purity không can thiệp, mọi lưu lượng do đầu ra quyết định"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "new",
