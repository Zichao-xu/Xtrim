    " · 本机只追得到代理网关，之后为代理段" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " · التتبع المحلي يصل لبوابة الوكيل فقط؛ بعدها مسار الوكيل"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " · Local trace ends at proxy gateway; proxy path follows"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " · ردیابی محلی فقط تا دروازهٔ پروکسی؛ ادامه در مسیر پروکسی است"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " · ローカル追跡はプロキシゲートウェイまで。以降はプロキシ区間"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " · 로컬 추적은 프록시 게이트웨이까지, 이후는 프록시 구간"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " · Локальная трасса до шлюза прокси, далее — участок прокси"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " · Yerel izleme proxy ağ geçidine kadar; sonrası proxy yolu"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " · Máy chỉ dò tới cổng proxy; sau đó là đoạn proxy"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " · 本機只能追到代理閘道，之後為代理區段"
          }
        }
      }
    },
