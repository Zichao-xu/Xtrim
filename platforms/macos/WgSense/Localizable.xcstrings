          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接続テーブルにノードサーバーアドレスがありません"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "연결 표에 노드 서버 주소가 없음"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Таблица соединений не содержит адрес сервера узла"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bağlantı tablosu düğüm sunucusu adresini vermedi"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bảng kết nối không cung cấp địa chỉ máy chủ nút"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
