          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バイトカウントで判定中。送信の再開を待っています"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "바이트 수 기준으로 판단 중, 전송 복구 대기"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оценка по счётчику байт, ждём возобновления отправки"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
