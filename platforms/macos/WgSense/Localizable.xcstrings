    "疑似接管：%@ 落在兜底网段 %@；后端答不上，无法确认真实去向" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اعتراض مشتبه: %1$@ يقع في النطاق الاحتياطي %2$@؛ والخلفية لا تجيب فلا يمكن تأكيد الوجهة الحقيقية"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Likely taken over: %@ falls in fallback subnet %@; backend can't answer, real destination unconfirmed"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "احتمال کنترل: %@ در شبکه ذخیره‌ای %@ است؛ بک‌اند پاسخ نمی‌دهد و مقصد واقعی تأیید‌شدنی نیست"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "乗っ取りの疑い：%@ がフォールバックサブネット %@ 内にあり、バックエンドが応答しないため実際の行き先は不明"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가로채기 의심: %@이(가) 대체 대역 %@에 속함. 백엔드 응답이 없어 실제 경로 확인 불가"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Возможно, перехват: %@ попал в резервную подсеть %@; бэкенд не отвечает, реальное назначение не подтвердить"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olası devralma: %1$@, %2$@ yedek ağ bloğunda; arka uç yanıt vermediği için gerçek yol doğrulanamıyor"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nghi bị tiếp quản: %1$@ nằm trong dải dự phòng %2$@; phần nền không trả lời nên không xác nhận được đích thật"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "疑似接管：%1$@ 落在兜底网段 %2$@；后端答不上，无法确认真实去向"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "疑似接管：%@ 落在備援網段 %@；後端答不出來，無法確認真實去向"
          }
        }
      }
    },
