        }
      }
    },
    "# 跳转逐跳手动跟随（每跳用真实 DNS 解析），最多 %lld 跳、每跳 %lld 秒" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "# تتبّع التحويلات يدويًا قفزة بقفزة (DNS حقيقي لكل قفزة)، حتى %lld قفزة، %lld ثانية لكل منها"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "# Follow redirects manually, hop by hop (real DNS each hop); up to %lld hops, %lld seconds each"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "# دنبال‌کردن دستی تغییرمسیرها، گام‌به‌گام (DNS واقعی در هر گام)؛ حداکثر %lld گام، هر گام %lld ثانیه"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "# リダイレクトを1段ずつ手動追跡（各段で実 DNS 解決）。最大%lld段、各%lld秒"
