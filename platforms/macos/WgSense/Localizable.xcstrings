          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dịch vụ mạng đang chạy chưa hỗ trợ đổi đầu ra; nhấn mihomo sẽ cập nhật dịch vụ mạng trước rồi mới chuyển"
          }
