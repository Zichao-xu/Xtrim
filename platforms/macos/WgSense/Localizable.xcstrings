    "本套规则加载以来被拒绝的出站包；规则重新加载后归零" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حزم الصادر المرفوضة منذ تحميل هذه القواعد؛ تُصفَّر بعد إعادة تحميل القواعد"
          }
