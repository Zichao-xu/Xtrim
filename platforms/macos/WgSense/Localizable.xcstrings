    "不随出口休眠：隧道与代理的境外流量也拒绝" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يبقى نشطًا عند سكون المخرج: يحظر أيضًا حركة النفق والوكيل الخارجية"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stays active when exit sleeps: also blocks foreign tunnel and proxy traffic"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هنگام خواب خروجی فعال می‌ماند: ترافیک خارجی تونل و پروکسی هم مسدود می‌شود"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "出口の休止中も有効：トンネル・プロキシの海外通信も拒否"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "출구 절전 중에도 활성: 터널·프록시 해외 트래픽도 차단"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Активно при спящем выходе: зарубежный трафик туннеля и прокси тоже блокируется"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çıkış uyurken etkin kalır: tünel ve proxy dış ülke trafiğini de engeller"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vẫn hoạt động khi đầu ra ngủ: chặn cả lưu lượng nước ngoài qua đường hầm và proxy"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不隨出口休眠：通道與代理的境外流量也拒絕"
          }
        }
      }
    },
    "不随时间更新；纯良接管时用它判断哪些是国内" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يُحدّث بمرور الوقت؛ يستخدمه Purity لتحديد الحركة المحلية عند تولي التحكم"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Not updated over time; Purity uses it to identify domestic traffic when taking over"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "با گذشت زمان به‌روز نمی‌شود؛ Purity هنگام کنترل، ترافیک داخلی را با آن تشخیص می‌دهد"
          }
