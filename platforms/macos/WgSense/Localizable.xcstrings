    "低于这个速度持续下面的秒数就断开换节点" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إذا بقيت السرعة أقل من هذا لمدة الثواني أدناه، فسيُقطع الاتصال وتُبدَّل العقدة"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disconnect and switch nodes if speed stays below this for the seconds shown"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اگر سرعت برای این تعداد ثانیه زیر این مقدار بماند، قطع و تغییر گره انجام می‌شود"
          }
        },
        "ja" : {
          "stringUnit" : {
