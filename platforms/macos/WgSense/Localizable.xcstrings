    "多久读一次计数；执行端不支持小数 sleep 时自动退到 1 秒" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كم مرة يُقرأ العد كل فترة؛ إذا لم يدعم المُنفِّذ sleep الكسري فسيُرتد تلقائيًا إلى ثانية واحدة"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How often to read counters; falls back to 1 sec if the runner doesn't support fractional sleep"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بازه خواندن شمارنده‌ها؛ اگر ماشین اجرا sleep اعشاری را پشتیبانی نکند، خودکار به ۱ ثانیه تغییر می‌کند"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カウンターを読み取る間隔。実行元が小数の sleep に対応しない場合は 1 秒に戻します"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "카운터를 읽는 주기. 실행 측이 소수 sleep을 지원하지 않으면 1초로 자동 전환"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Как часто читать счётчики; если исполнитель не поддерживает дробный sleep, шаг — 1 секунда"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sayacın hangi sıklıkla okunacağı; çalıştırıcı ondalık sleep desteklemiyorsa otomatik olarak 1 saniyeye düşer"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bao lâu đọc bộ đếm một lần; nếu bên thực thi không hỗ trợ sleep thập phân sẽ tự lùi về 1 giây"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "多久讀一次計數；執行端不支援小數 sleep 時自動退回 1 秒"
          }
        }
      }
    },
