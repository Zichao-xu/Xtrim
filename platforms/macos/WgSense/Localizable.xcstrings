            "value" : "iperf3 -s -p %lld -D -i %@ -f m --forceflush --logfile <ログ>   # 接続先；ポート使用中なら %lld まで順送り、%lld 秒後に自動終了"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iperf3 -s -p %lld -D -i %@ -f m --forceflush --logfile <로그>   # 상대; 포트 사용 중이면 %lld까지 순차 이동, %lld초 후 자동 종료"
          }
        },
        "ru" : {
