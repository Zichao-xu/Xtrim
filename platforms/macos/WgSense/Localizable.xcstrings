    "连接表没有给出节点服务器地址" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جدول الاتصالات لم يقدم عنوان خادم العقدة"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The connection table didn't provide the node server address"
          }
        },
        "fa" : {
