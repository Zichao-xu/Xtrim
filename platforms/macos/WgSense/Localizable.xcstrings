    "# 比最快的慢 %@ 倍以上的淘汰；下行留前 %lld 个，上行留前 %lld 个" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "# استبعاد الأبطأ من الأسرع بأكثر من %@ ضعف؛ إبقاء أفضل %lld للتنزيل و%lld للرفع"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "# Drop sources over %@ times slower than fastest; keep top %lld for download, top %lld for upload"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "# منابع بیش از %@ برابر کندتر از سریع‌ترین حذف شوند؛ %lld منبع برتر دانلود و %lld منبع برتر آپلود بمانند"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "# 最速より%@倍以上遅い候補を除外。下りは上位%lld件、上りは上位%lld件を採用"
