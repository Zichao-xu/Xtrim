            "state" : "translated",
            "value" : "iperf3 -s -p %lld -D -i %@ -f m --forceflush --logfile <گزارش>   # همتا؛ اگر درگاه اشغال بود، افزایش تا %lld؛ خروج پس از %lld ثانیه"
