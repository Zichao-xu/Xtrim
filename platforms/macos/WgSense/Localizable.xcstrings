    "按未接管处理：后端答不上，且 %@ 不在兜底网段" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُعامَل كغير متولَّى: الخلفية لا تجيب، و%@ ليس في النطاق الاحتياطي"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Treated as not taken over: backend can't answer and %@ isn't in the fallback subnet"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بدون کنترل در نظر گرفته می‌شود: بک‌اند پاسخ نمی‌دهد و %@ در شبکه ذخیره‌ای نیست"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未乗っ取りとして処理：バックエンドが応答せず、%@ もフォールバックサブネット外"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "미차단으로 처리: 백엔드 응답 없음, %@이(가) 대체 대역에 없음"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Считается не перехваченным: бэкенд не отвечает и %@ не в резервной подсети"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Devralınmamış sayılır: arka uç yanıt vermiyor ve %@ yedek ağ bloğunda değil"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coi như chưa bị tiếp quản: phần nền không trả lời, và %@ không thuộc dải dự phòng"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "依未接管處理：後端答不出來，且 %@ 不在備援網段"
          }
        }
      }
    },
