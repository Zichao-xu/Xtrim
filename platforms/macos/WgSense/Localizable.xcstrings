    "出口不在时境外连接可从物理网卡直接出去" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند غياب المخرج يمكن للاتصالات الخارجية الخروج مباشرة عبر بطاقة الشبكة الفعلية"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foreign connections can leave directly via the physical interface when the exit is absent"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وقتی خروجی نباشد، اتصال‌های خارجی می‌توانند مستقیماً از کارت شبکه فیزیکی خارج شوند"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "出口がないときは海外への接続が物理インターフェースから直接出られます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "출구가 없으면 해외 연결이 실제 네트워크 카드로 직접 나갈 수 있음"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Без выхода зарубежные соединения могут уходить напрямую через физический интерфейс"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çıkış yokken yurt dışı bağlantılar fiziksel ağ kartından doğrudan çıkabilir"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi không có đầu ra, kết nối ra nước ngoài có thể đi thẳng qua card mạng vật lý"
