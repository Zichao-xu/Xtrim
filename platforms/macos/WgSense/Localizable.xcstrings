          "stringUnit" : {
            "state" : "translated",
            "value" : "إذا لم ينتهِ بعد ضعف المدة الإجمالية زائد هذه الثواني فسيُنهى قسرًا"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If still running after total duration × 2 plus these seconds, force it to finish"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اگر تا مجموع زمان × ۲ به‌علاوه این ثانیه‌ها تمام نشد، به‌اجبار پایان داده شود"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "合計時間 × 2 にこの秒数を足しても終わらなければ強制終了します"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "총 소요 × 2에 이 시간(초)을 더해도 끝나지 않으면 강제 종료"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если за общее время × 2 плюс столько секунд проверка не завершилась — принудительно завершить"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toplam sürenin iki katı artı bu saniye kadar geçince hâlâ bitmediyse zorla sonlandırılır"
