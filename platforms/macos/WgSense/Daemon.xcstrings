        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "# WgSense 內建代理核心的預設設定（首次啟動自動產生，可換成自己的設定）\n# 僅監聽本機連接埠，不啟用 TUN、不接管 DNS、不更改系統代理。\nmixed-port: 7895\nbind-address: 127.0.0.1\nallow-lan: false\nmode: rule\nlog-level: warning\ngeo-auto-update: false\nprofile:\n  store-selected: true\nproxies: []\nrules:\n  - MATCH,DIRECT"
