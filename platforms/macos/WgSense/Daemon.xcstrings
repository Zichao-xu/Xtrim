          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "# Настройки встроенного прокси-ядра WgSense (создаются при первом запуске; можно заменить своими)\n# Только локальные порты; без TUN, перехвата DNS и изменения системного прокси.\nmixed-port: 7895\nbind-address: 127.0.0.1\nallow-lan: false\nmode: rule\nlog-level: warning\ngeo-auto-update: false\nprofile:\n  store-selected: true\nproxies: []\nrules:\n  - MATCH,DIRECT"
